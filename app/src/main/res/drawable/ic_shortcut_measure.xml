<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut: the weigh-in glyph on the brand disc, the same pairing as the launcher icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0F6B62" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:drawable="@drawable/ic_tile_measure"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
